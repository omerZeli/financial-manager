# Financial Manager MCP server configuration (EXAMPLE).
#
# Copy this file to `mcp-server/.env` and fill in real values, OR provide these
# variables directly in your MCP client config / shell environment. The real
# `.env` file is git-ignored and must never be committed.
#
# This file is tracked and must contain NON-SENSITIVE placeholders only.
# Every variable the server consumes is listed below.

# Supabase project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. The server uses the anon key only - never the
# service-role key.
SUPABASE_ANON_KEY=your-anon-key

# User email used for signInWithPassword.
# Primary name, with FINANCIAL_MANAGER_EMAIL as a fallback alias.
# If both are set, SUPABASE_USER_EMAIL wins.
SUPABASE_USER_EMAIL=you@example.com
# FINANCIAL_MANAGER_EMAIL=you@example.com

# User password used for signInWithPassword.
# Primary name, with FINANCIAL_MANAGER_PASSWORD as a fallback alias.
# If both are set, SUPABASE_USER_PASSWORD wins.
SUPABASE_USER_PASSWORD=your-password
# FINANCIAL_MANAGER_PASSWORD=your-password
